rules_version = '2';

// WATTWISE Firestore security rules.
// Principle: deny by default. A user reads/writes only their own user document;
// household data is visible only to the household's members.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function household(hid) { return get(/databases/$(database)/documents/households/$(hid)).data; }
    function isMember(hid) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(hid))
        && request.auth.uid in household(hid).memberIds;
    }
    function isOwner(hid) { return signedIn() && household(hid).ownerId == request.auth.uid; }
    function launchCountry(c) { return c in ['FR', 'BE', 'DE', 'ES', 'PT', 'NL']; }
    function languageOk(l) { return l in ['en', 'fr', 'de', 'es', 'pt', 'nl', 'it']; }

    // ── users/{uid}: profile, preferences, consents, householdId
    match /users/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'country', 'language', 'theme', 'consents', 'householdId', 'createdAt', 'updatedAt'])
        && launchCountry(request.resource.data.country)
        && languageOk(request.resource.data.language)
        && request.resource.data.consents.dataProcessing is string
        // A user may only point to a household they belong to (or are creating in the same batch).
        && (request.resource.data.get('householdId', null) == null
            || uid in getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.memberIds);
    }

    // ── households/{hid}
    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && launchCountry(request.resource.data.country)
        && request.resource.data.occupants is int
        && request.resource.data.occupants >= 1 && request.resource.data.occupants <= 20;
      // Members can edit household details; only the owner can change membership or ownership.
      allow update: if isMember(hid)
        && launchCountry(request.resource.data.country)
        && (isOwner(hid) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'memberIds']))
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(hid);

      // ── confirmed energy bills
      match /energy_bills/{billId} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.origin in ['ai_extraction', 'manual', 'demo']
          && request.resource.data.data.energyType in ['electricity', 'gas']
          && request.resource.data.data.consumption is number && request.resource.data.data.consumption > 0
          && request.resource.data.data.totalAmount is number && request.resource.data.data.totalAmount >= 0
          && request.resource.data.data.periodStart is string
          && request.resource.data.data.periodEnd is string
          && request.resource.data.data.periodEnd >= request.resource.data.data.periodStart;
        allow update: if false; // bills are immutable once confirmed: delete and re-add to correct
        allow delete: if isMember(hid);
      }
    }

    // Server-only collections (written via Admin SDK, never by clients).
    match /audit_logs/{doc=**} { allow read, write: if false; }
    match /subscriptions/{doc=**} { allow read, write: if false; }
  }
}
