rules_version = '2';

// Original bill documents, stored only when the user opts in.
// Files live under the uploading user's own folder, so access needs no
// cross-service lookup: only that user can read or delete them.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/bills/{billId}/original {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');
      allow update: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
