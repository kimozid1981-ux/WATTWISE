{
  "name": "wattwise-desktop-shell",
  "private": true,
  "version": "0.1.0",
  "description": "Windows test build: wraps the offline static WATTWISE web bundle with Electron.",
  "author": "WATTWISE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "eu.wattwise.desktop",
    "productName": "WATTWISE",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../../apps/web/out", "to": "web" }],
    "win": { "target": ["portable"], "artifactName": "WATTWISE-${version}-test-portable.exe" }
  }
}
