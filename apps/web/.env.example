# Copy to .env.local and fill in. NEVER commit real values.
#
# ── Firebase web app config (Firebase console → Project settings → Your apps → Web app)
# These identify your Firebase project; they are not secrets. Security comes from
# Firestore/Storage rules and App Check. Leave empty to run in LOCAL MODE
# (data stays in this browser only, no account).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: reCAPTCHA Enterprise site key for Firebase App Check
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# ── AI document extraction (SERVER ONLY — never prefix with NEXT_PUBLIC_)
# Without these, bill upload falls back to guided manual entry.
OPENAI_API_KEY=
# Choose a current OpenAI model that supports PDF + image input and structured outputs.
OPENAI_MODEL=
# Optional, defaults to https://api.openai.com/v1
OPENAI_BASE_URL=

# ── Access control for the extraction endpoint
# In production the endpoint requires a Firebase ID token. For local development
# without Firebase you may allow anonymous calls (never enable in production).
ALLOW_ANONYMOUS_EXTRACTION=false

# ── Development only: use the local Firebase Emulator Suite (firebase emulators:start)
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
